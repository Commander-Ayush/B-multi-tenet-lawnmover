# Copy this to .env (already gitignored) and fill in real values.
# This file itself is just documentation — Spring Boot doesn't read .env
# directly; however you're currently loading these (shell export, Docker
# env_file, IDE run config), the same approach still works — these are
# exactly the same property names as before, plus the two new JWT ones.

DATABASE_URL=jdbc:postgresql://localhost:5432/lawnmovers
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=changeme

# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-string-at-least-32-characters

# Optional — defaults to 24h (86400000 ms) if omitted
JWT_EXPIRATION_MS=86400000
